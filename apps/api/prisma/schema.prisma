// Schema del database centrale di Sedinho (vedi CLAUDE.md e specs/funzionale-v1.md).
// Provider PostgreSQL (Neon), come previsto dalla spec (sez. 17). binaryTargets include il
// runtime delle funzioni serverless di Vercel oltre a quello locale di sviluppo.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Configurazione lega (sez. 3)
// ---------------------------------------------------------------------------

model League {
  id                 String   @id @default(cuid())
  name               String
  participants       Int
  initialBudget      Int
  rosterComposition  String   // JSON: { P: number, D: number, C: number, A: number }
  allowedModules     String   // JSON: string[]
  auctionMode        String
  callOrder          String   // JSON: CallOrderRule
  rulesText          String
  parsedRules        String   // JSON: ParsedRule[]
  entryFee           String?  // JSON: EntryFeeConfig
  prizePool          String?  // JSON: PrizePoolEntry[]
  cupFormat          String?  // JSON: CupFormat
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  participantsList Participant[]
  auctions         Auction[]
}

// `League.participants` e' solo il numero previsto dal Setup Wizard (sez. 3): per l'asta live
// (sez. 11) serve sapere CHI sono, per calcolare budget residuo e fabbisogno di ruolo per
// ciascuno. Creati al volo la prima volta che si avvia un'asta (vedi routes/auctions.ts), non
// nel Setup Wizard, per non appesantire quel flusso con un input che serve solo più avanti.
model Participant {
  id       String  @id @default(cuid())
  leagueId String
  league   League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name     String
  isMe     Boolean @default(false)

  createdAt DateTime @default(now())

  auctionEntries AuctionEntry[]

  @@index([leagueId])
}

// ---------------------------------------------------------------------------
// Anagrafica e dati centrali dei giocatori (sez. 4)
// ---------------------------------------------------------------------------

model Player {
  id                    String   @id @default(cuid())
  name                  String
  team                  String
  role                  String   // P | D | C | A (ridefinibile dalla lega)
  birthDate             DateTime?
  nationality           String?
  foot                  String?  // left | right | both
  availability          String   @default("available") // available | injured | suspended | doubtful
  estimatedRecoveryDate DateTime?
  initialQuotation      Int?     // quotazione ufficiale di partenza (listone), crediti, modalita Classic

  source      String
  updatedAt   DateTime @updatedAt
  reliability Float    @default(1)
  createdAt   DateTime @default(now())

  seasonStats      SeasonStats[]
  hierarchies      PlayerHierarchy[]
  setPieceRoles    SetPieceRole[]
  transfers        Transfer[]
  evaluations      PlayerEvaluation[]
  auctionEntries   AuctionEntry[]
  shortlistEntry   ShortlistEntry?

  @@index([team])
  @@index([role])
}

// Obiettivi d'asta dell'utente (non della lega: Sedinho e' single-user, vedi CLAUDE.md sez. 5),
// da tenere in vista durante l'asta live. Un solo entry per giocatore: @@unique(playerId) invece
// di permettere doppioni, "aggiungere di nuovo" un giocatore gia' in shortlist non ha senso.
model ShortlistEntry {
  id        String   @id @default(cuid())
  playerId  String   @unique
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())
}

model SeasonStats {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  season      String
  competition String

  appearances      Int   @default(0)
  minutes          Int   @default(0)
  fantasyAvg       Float @default(0)
  averageRating    Float @default(0)
  goals            Int   @default(0)
  assists          Int   @default(0)
  xG               Float @default(0)
  xA               Float @default(0)
  shots            Int   @default(0)
  shotsOnTarget    Int   @default(0)
  yellowCards      Int   @default(0)
  redCards         Int   @default(0)
  penaltiesScored  Int   @default(0)
  penaltiesTaken   Int   @default(0)
  cleanSheets      Int   @default(0)
  expectedBonus    Float @default(0)
  // Frazione (0..1) di partite ufficiali saltate per infortunio in questa stagione, null se
  // nessuna fonte la fornisce ancora (nessun connettore attivo la popola, vedi CLAUDE.md).
  injuryAbsenceRate Float?

  source      String
  updatedAt   DateTime @updatedAt
  reliability Float    @default(1)

  @@unique([playerId, season, competition])
  @@index([season])
}

model PlayerHierarchy {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  level       String // starter | first-alternate | second-alternate
  reliability Float

  source    String
  updatedAt DateTime @updatedAt

  @@index([playerId])
}

model SetPieceRole {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  type        String // penalty-1 | penalty-2 | penalty-3 | direct-free-kick-1 | direct-free-kick-2 | corner | side-free-kick
  probability Float

  source    String
  updatedAt DateTime @updatedAt

  @@unique([playerId, type])
}

model TeamRotationProfile {
  id   String @id @default(cuid())
  team String @unique

  numberOfCompetitions        Int
  turnoverFrequency           Float
  coachReliability             Float
  turnoverProbabilityByRole   String // JSON: Partial<Record<PlayerRole, number>>

  source    String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Trasferimenti (sez. 6)
// ---------------------------------------------------------------------------

model Transfer {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  fromTeam String?
  toTeam   String
  date     DateTime

  startingRoleImpact     Float
  minutesImpact          Float
  bonusImpact            Float
  riskDelta              Float
  fantasyValueDelta      Float
  newStarterProbability  Float
  isHighlighted          Boolean @default(false)

  source    String
  updatedAt DateTime @updatedAt

  @@index([playerId])
}

// ---------------------------------------------------------------------------
// Valutazioni (sez. 8)
// ---------------------------------------------------------------------------

model PlayerEvaluation {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  computedAt DateTime @default(now())

  reliability String // JSON: ReliabilityIndices
  production  String // JSON: ProductionIndices
  bonus       String // JSON: BonusIndices
  stability   String // JSON: StabilityIndices
  value       String // JSON: ValueIndices
  explanation String // JSON: Explanation

  @@index([playerId])
}

// ---------------------------------------------------------------------------
// Asta live (sez. 11-13)
// ---------------------------------------------------------------------------

model Auction {
  id        String    @id @default(cuid())
  leagueId  String
  league    League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  entries AuctionEntry[]

  @@index([leagueId])
}

model AuctionEntry {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  price Int

  buyerId String
  buyer   Participant @relation(fields: [buyerId], references: [id])

  timestamp DateTime  @default(now())
  // Soft-delete per "Annulla ultima azione" (sez. 11, richiesto esplicitamente dall'utente):
  // null = inserimento attivo, valorizzato = annullato. Serve a poter "ripristinare" l'ultima
  // rimozione senza aver perso i dati della riga (un DELETE vero non sarebbe reversibile).
  revokedAt DateTime?

  // Un giocatore puo' essere assegnato una sola volta PER ASTA TRA GLI INSERIMENTI ATTIVI:
  // vincolo reale solo come indice unico parziale (WHERE revokedAt IS NULL), applicato via SQL
  // nella migrazione — Prisma schema language non supporta unique constraint con WHERE clause,
  // quindi non è dichiarato qui con @@unique (che sarebbe un unique su tutta la tabella e
  // impedirebbe di riassegnare un giocatore dopo un annulla). Vedi migration.sql.
  @@index([auctionId])
  @@index([playerId])
  @@index([buyerId])
}

// Autenticazione (richiesta esplicitamente dall'utente): più utenti possono avere un account,
// ma condividono tutti gli stessi dati (una sola League, vedi CLAUDE.md sez. 5 "singola lega
// attiva") — non e' multi-tenancy, e' solo per impedire che chiunque trovi l'URL possa vedere/
// modificare la lega. Registrazione protetta da un codice di invito condiviso (env var
// SIGNUP_CODE), non aperta a chiunque.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  sessions Session[]
}

// Sessioni come righe DB referenziate da un token opaco nel cookie, non JWT: più semplice da
// revocare (basta cancellare la riga, es. al logout) e non introduce una libreria JWT nelle
// dipendenze (valutata e scartata: @fastify/jwt@8, l'ultima versione compatibile con Fastify 4
// qui in uso, dipende da una versione di fast-jwt con multiple CVE note, incluso un bypass di
// autenticazione — non accettabile per la funzionalità che sta proprio proteggendo l'accesso).
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model OpponentProfile {
  id            String @id @default(cuid())
  participantId String @unique

  aggressiveness        Float @default(0)
  averageSpend          Float @default(0)
  topPlayerPreference   Float @default(0)
  youngPlayerPreference Float @default(0)
  teamPreferences       String @default("{}") // JSON: Record<string, number>
  spendConcentration    Float @default(0)
  remainingBudget       Float @default(0)
  overpayIndex          Float @default(0)

  updatedAt DateTime @updatedAt
}
